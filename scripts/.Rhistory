getmode <- function(v){
uniqv <- unique(v)
uniqv[which.max(tabulate(match(v, uniqv))))]}
uniqv[which.max(tabulate(match(v, uniqv)))]}
uniqv[which.max(tabulate(match(v, uniqv)))]}
uniqv[which.max(tabulate(match(v, uniqv)))]
getmode <- function(v){
uniqv <- unique(v)
uniqv[which.max(tabulate(match(v, uniqv)))]
}
